#!/usr/bin/env bash
#
# The "m3u4me" command — installed to /usr/local/bin by install.sh. It only works
# with installs made by install.sh (the m3u4me systemd service in /opt/m3u4me).
#
#   sudo m3u4me update     update to the latest release and restart
#   m3u4me status          is it running?
#   sudo m3u4me logs       follow the live log
#   sudo m3u4me restart    restart it
#   m3u4me version         which release is installed
#   sudo m3u4me uninstall  remove m3u4me (keeps your playlists unless --purge)

set -euo pipefail

APP_DIR="/opt/m3u4me"
APP_USER="m3u4me"
SERVICE_NAME="m3u4me"
ENV_FILE="/etc/m3u4me.env"
CLI_PATH="/usr/local/bin/m3u4me"
UNIT_FILE="/etc/systemd/system/${SERVICE_NAME}.service"

say()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m !!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m xx\033[0m %s\n' "$*" >&2; exit 1; }

need_root() {
  [ "$(id -u)" -eq 0 ] || die "This needs root. Try:  sudo m3u4me $*"
}

require_install() {
  [ -f "$UNIT_FILE" ] && [ -d "$APP_DIR/.git" ] \
    || die "No m3u4me install found. This command only works with installs made by install.sh."
}

# Runs a command as the m3u4me user, from inside the app folder. npm runs this
# way so that package install scripts never run as root. git runs this way too:
# the folder belongs to the m3u4me user, and git refuses to work in a folder
# owned by someone else.
run_as_app() {
  if command -v runuser >/dev/null 2>&1; then
    ( cd "$APP_DIR" && runuser -u "$APP_USER" -- env HOME="$APP_DIR" npm_config_cache="$APP_DIR/.npm" "$@" )
  else
    ( cd "$APP_DIR" && sudo -u "$APP_USER" env HOME="$APP_DIR" npm_config_cache="$APP_DIR/.npm" "$@" )
  fi
}

read_port() {
  ( unset PORT; . "$ENV_FILE" >/dev/null 2>&1 || true; echo "${PORT:-8080}" )
}

# Waits up to a minute for the service to be up and actually answering web
# requests. "systemctl restart" reports success as soon as the process launches,
# even if the app crashes a second later, so that alone proves nothing.
# (install.sh has the same check.)
wait_until_running() {
  local port="$1" tries=60
  while [ "$tries" -gt 0 ]; do
    if systemctl is-active --quiet "$SERVICE_NAME" \
      && curl -fsS -o /dev/null --max-time 3 "http://127.0.0.1:${port}/api/auth/status"; then
      return 0
    fi
    sleep 1
    tries=$((tries - 1))
  done
  return 1
}

cmd_update() {
  need_root update
  require_install

  local current new restarted=0
  # A tag name like v2.1.0 when on a release, or a short commit id otherwise.
  current="$(run_as_app git describe --tags --exact-match 2>/dev/null || run_as_app git rev-parse --short HEAD)"
  say "Checking for updates (currently on ${current}) ..."
  run_as_app git fetch --tags --force --quiet origin \
    || die "Couldn't reach GitHub to check for updates. Check this server's internet connection, then try again."

  # The release tag with the highest version number.
  new="$(run_as_app git for-each-ref --sort=-version:refname --count=1 --format='%(refname:short)' 'refs/tags/v*')"
  [ -n "$new" ] || die "No releases found."

  if [ "$current" = "$new" ]; then
    say "Already on the latest release (${current}). Nothing to do."
    return
  fi

  say "Updating ${current} → ${new} ..."

  # Called whenever a step below fails. Puts the previous release back — code,
  # dependencies and the built app — so what is on disk matches what runs. If the
  # new release had already been started, the previous one is started again too.
  rollback() {
    warn "$1 — putting ${current} back ..."
    run_as_app git checkout --quiet --force "$current" >/dev/null 2>&1 || true
    run_as_app npm ci --no-audit --no-fund --loglevel=error >/dev/null 2>&1 || true
    run_as_app npm run build >/dev/null 2>&1 || true
    if [ "$restarted" -eq 1 ]; then
      systemctl restart "$SERVICE_NAME" || true
      if wait_until_running "$(read_port)"; then
        die "Update failed — rolled back to ${current}, which is running again."
      fi
      die "Update failed, and ${current} did not start again either. See what went wrong with:  sudo m3u4me logs"
    fi
    die "Update failed — rolled back to ${current}. The running app was not restarted."
  }

  run_as_app git checkout --quiet --force "$new" || rollback "Couldn't switch to ${new}"

  say "Installing dependencies ..."
  run_as_app npm ci --no-audit --no-fund --loglevel=error || rollback "Installing dependencies failed"

  say "Building ..."
  run_as_app npm run build || rollback "Building the app failed"
  [ -f "$APP_DIR/dist/index.html" ] || rollback "The build did not produce the app"

  say "Restarting ..."
  restarted=1
  systemctl restart "$SERVICE_NAME" || rollback "Restarting failed"
  wait_until_running "$(read_port)" || rollback "${new} did not start"

  # Refresh this command too, now that the new release is known to work. install
  # writes a new file and mv swaps it in whole, so the copy bash is reading from
  # right now is left intact.
  if [ -f "$APP_DIR/scripts/m3u4me" ]; then
    { install -m 0755 "$APP_DIR/scripts/m3u4me" "${CLI_PATH}.new" && mv -f "${CLI_PATH}.new" "$CLI_PATH"; } \
      || warn "The update worked, but the m3u4me command itself couldn't be refreshed."
  fi

  say "m3u4me is now on ${new}."
}

cmd_service() {
  local action="$1"
  need_root "$action"
  require_install
  systemctl "$action" "$SERVICE_NAME"
  if [ "$action" = "stop" ]; then
    say "Stopped."
    return
  fi
  wait_until_running "$(read_port)" || die "m3u4me did not start. See what went wrong with:  sudo m3u4me logs"
  say "m3u4me is running."
}

cmd_status() {
  require_install
  systemctl status "$SERVICE_NAME" --no-pager
}

cmd_logs() {
  # Reading a system service's log needs root on most systems (unless you are in
  # the adm or systemd-journal group), so ask for sudo instead of showing nothing.
  need_root logs
  require_install
  journalctl -u "$SERVICE_NAME" -n 100 -f
}

cmd_version() {
  require_install
  # Read from package.json — the same place the app's About section gets it from.
  echo "v$(node -p "require('${APP_DIR}/package.json').version")"
}

cmd_uninstall() {
  need_root uninstall
  local purge=0 assume_yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      --purge) purge=1 ;;
      --yes|-y) assume_yes=1 ;;
      *) die "Unknown option: $arg" ;;
    esac
  done

  [ -d "$APP_DIR" ] || [ -f "$UNIT_FILE" ] || die "No m3u4me install found."

  if [ "$purge" -eq 1 ]; then
    echo "This removes m3u4me AND permanently deletes your playlists in ${APP_DIR}/data."
  else
    echo "This removes m3u4me but keeps your playlists in ${APP_DIR}/data."
  fi

  if [ "$assume_yes" -eq 0 ]; then
    [ -t 0 ] || die "Not running interactively — pass --yes to confirm."
    read -r -p "Type 'yes' to continue: " reply
    [ "$reply" = "yes" ] || die "Cancelled."
  fi

  if [ -f "$UNIT_FILE" ]; then
    systemctl disable --now "$SERVICE_NAME" >/dev/null 2>&1 || true
    rm -f "$UNIT_FILE"
    systemctl daemon-reload
  fi

  if [ "$purge" -eq 1 ]; then
    rm -rf "$APP_DIR"
    rm -f "$ENV_FILE"
    userdel "$APP_USER" >/dev/null 2>&1 || true
    say "m3u4me and all its data have been removed."
  else
    # Keep data/ by moving it aside while the rest of the folder is deleted. The
    # temporary folder sits right next to /opt/m3u4me rather than in /tmp, so the
    # move stays on the same disk and is instant, however big the database is.
    local keep
    keep="$(mktemp -d "${APP_DIR}.keep.XXXXXX")"
    [ -d "$APP_DIR/data" ] && mv "$APP_DIR/data" "$keep/data"
    rm -rf "$APP_DIR"
    if [ -d "$keep/data" ]; then
      mkdir -p "$APP_DIR"
      mv "$keep/data" "$APP_DIR/data"
    fi
    rmdir "$keep" 2>/dev/null || true
    say "m3u4me has been removed. Your playlists are still in ${APP_DIR}/data, and your port setting in ${ENV_FILE}."
  fi

  rm -f "$CLI_PATH"
}

usage() {
  cat <<'EOF'
m3u4me — self-hosted M3U playlist manager

Usage: m3u4me <command>

  update              Update to the latest release and restart (needs sudo)
  start|stop|restart  Control the service (needs sudo)
  status              Show whether m3u4me is running
  logs                Follow the live log, Ctrl+C to stop (needs sudo)
  version             Show the installed release
  uninstall [--purge] Remove m3u4me. Keeps your playlists unless --purge (needs sudo)

EOF
}

case "${1:-help}" in
  update)             shift; cmd_update "$@" ;;
  start|stop|restart) cmd_service "$1" ;;
  status)             cmd_status ;;
  logs)               cmd_logs ;;
  version)            cmd_version ;;
  uninstall)          shift; cmd_uninstall "$@" ;;
  help|-h|--help)     usage ;;
  *)                  usage; exit 1 ;;
esac
